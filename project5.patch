diff --git a/kernel/futex.c b/kernel/futex.c
new file mode 100644
index 0000000..b86d519
--- /dev/null
+++ b/kernel/futex.c
@@ -0,0 +1,109 @@
+// futex_wait(addr, val) / futex_wake(addr, n)
+//
+// The kernel half of a futex: a place to sleep while a user-space word has
+// a particular value, and a way to wake sleepers. All policy (what the word
+// means, who owns the lock) stays in user space; see user/usync.c.
+//
+// Wait queues are keyed on the *physical* address of the word, not the
+// virtual one. For pages mapped by shm_map() that is what makes the futex
+// work between processes: parent and child see the word at the same virtual
+// address, and so would any two unrelated private pages, but only shared
+// pages have the same physical address.
+//
+// Queues live in a small hash table, NFUTEXQ buckets, one lock each, so
+// unrelated futexes rarely contend. Each waiter sits in its bucket's list
+// with its key; wake walks the (short) list and picks the matching ones in
+// FIFO order.
+
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "riscv.h"
+#include "spinlock.h"
+#include "proc.h"
+#include "defs.h"
+#include "waitq.h"
+
+static struct {
+  struct spinlock lock;
+  struct waitq q;
+} bucket[NFUTEXQ];
+
+void
+futexinit(void)
+{
+  int i;
+
+  for (i = 0; i < NFUTEXQ; i++) {
+    initlock(&bucket[i].lock, "futex");
+    wq_init(&bucket[i].q);
+  }
+}
+
+#define BUCKET(key) (&bucket[((key) >> 2) % NFUTEXQ])
+
+// int futex_wait(int *addr, int val)
+//
+// If *addr == val, sleep until futex_wake() on the same word picks us.
+// The comparison and going to sleep happen under the bucket lock, and
+// futex_wake() takes the same lock, so a wake can't fall between the two.
+//
+//   0   woken up
+//   1   *addr != val, didn't sleep (the caller should look at the word again)
+//  -1   bad address (null, unaligned, unmapped), or killed while waiting
+uint64
+sys_futex_wait(void)
+{
+  struct proc *p = myproc();
+  uint64 uaddr, key;
+  int val, r;
+  struct waiter w;
+
+  argaddr(0, &uaddr);
+  argint(1, &val);
+  if (uaddr % sizeof(int) != 0)
+    return -1;
+  if ((key = uva2pa(p->pagetable, p->sz, uaddr)) == 0)
+    return -1;
+
+  acquire(&BUCKET(key)->lock);
+  // The kernel maps all RAM 1:1, so key is also a kernel pointer. A user
+  // process on another CPU may be storing to this word right now, hence
+  // the atomic load.
+  if (__atomic_load_n((int *)key, __ATOMIC_ACQUIRE) != val) {
+    release(&BUCKET(key)->lock);
+    return 1;
+  }
+  wq_enqueue(&BUCKET(key)->q, &w, key);
+  r = wq_block(&w, &BUCKET(key)->lock);
+  release(&BUCKET(key)->lock);
+  return r;
+}
+
+// int futex_wake(int *addr, int n)
+// Wake at most n processes waiting on addr, oldest first (n < 0: all).
+// Returns the number woken, or -1 for a bad address.
+uint64
+sys_futex_wake(void)
+{
+  struct proc *p = myproc();
+  uint64 uaddr, key;
+  int n, woken;
+
+  argaddr(0, &uaddr);
+  argint(1, &n);
+  if (uaddr % sizeof(int) != 0)
+    return -1;
+
+  // Don't fault pages in just to wake nobody: a word whose page isn't
+  // mapped yet (lazy heap) can't have any sleepers.
+  key = walkaddr(p->pagetable, uaddr);
+  if (key == 0)
+    return uaddr < p->sz ? 0 : -1;
+  key += uaddr & (PGSIZE - 1);
+
+  acquire(&BUCKET(key)->lock);
+  woken = wq_wake_key(&BUCKET(key)->q, key, n);
+  release(&BUCKET(key)->lock);
+  return woken;
+}
diff --git a/kernel/kalloc.c b/kernel/kalloc.c
index 2fcec38..7221d0f 100644
--- a/kernel/kalloc.c
+++ b/kernel/kalloc.c
@@ -23,6 +23,14 @@ struct {
   struct run *freelist;
 } kmem;
 
+// One reference count per physical page. A page that came out of kalloc()
+// starts at 1; krefinc() adds a holder and kfree() only gives the page back
+// once the last holder is gone. shm_map() pages rely on this: they sit in
+// several page tables at once, and whoever exits last has to free them.
+// Protected by kmem.lock.
+#define PAIDX(pa) (((uint64)(pa) - KERNBASE) / PGSIZE)
+static uchar refcnt[(PHYSTOP - KERNBASE) / PGSIZE];
+
 void
 kinit()
 {
@@ -35,22 +43,33 @@ freerange(void *pa_start, void *pa_end)
 {
   char *p;
   p = (char *)PGROUNDUP((uint64)pa_start);
-  for (; p + PGSIZE <= (char *)pa_end; p += PGSIZE)
+  for (; p + PGSIZE <= (char *)pa_end; p += PGSIZE) {
+    refcnt[PAIDX(p)] = 1; // so that the kfree() below drops it to 0
     kfree(p);
+  }
 }
 
-// Free the page of physical memory pointed at by pa,
-// which normally should have been returned by a
-// call to kalloc().  (The exception is when
-// initializing the allocator; see kinit above.)
+// Drop one reference to the page of physical memory pointed at by pa,
+// which normally should have been returned by a call to kalloc().
+// (The exception is when initializing the allocator; see kinit above.)
+// The page goes back on the free list when the last reference is gone.
 void
 kfree(void *pa)
 {
   struct run *r;
+  int last;
 
   if (((uint64)pa % PGSIZE) != 0 || (char *)pa < end || (uint64)pa >= PHYSTOP)
     panic("kfree");
 
+  acquire(&kmem.lock);
+  if (refcnt[PAIDX(pa)] == 0)
+    panic("kfree: refcnt");
+  last = (--refcnt[PAIDX(pa)] == 0);
+  release(&kmem.lock);
+  if (!last)
+    return;
+
   // Fill with junk to catch dangling refs.
   memset(pa, 1, PGSIZE);
 
@@ -72,11 +91,27 @@ kalloc(void)
 
   acquire(&kmem.lock);
   r = kmem.freelist;
-  if (r)
+  if (r) {
     kmem.freelist = r->next;
+    refcnt[PAIDX(r)] = 1;
+  }
   release(&kmem.lock);
 
   if (r)
     memset((char *)r, 5, PGSIZE); // fill with junk
   return (void *)r;
 }
+
+// Add a reference to a page that is already allocated.
+void
+krefinc(void *pa)
+{
+  if (((uint64)pa % PGSIZE) != 0 || (char *)pa < end || (uint64)pa >= PHYSTOP)
+    panic("krefinc");
+
+  acquire(&kmem.lock);
+  if (refcnt[PAIDX(pa)] == 0 || refcnt[PAIDX(pa)] == 255)
+    panic("krefinc: bad count");
+  refcnt[PAIDX(pa)]++;
+  release(&kmem.lock);
+}
