diff --git a/kernel/vm.c b/kernel/vm.c
index f50650b..3a37d2b 100644
--- a/kernel/vm.c
+++ b/kernel/vm.c
@@ -489,3 +489,73 @@ ismapped(pagetable_t pagetable, uint64 va)
   }
   return 0;
 }
+
+// Give the process npages of fresh, zeroed, shared memory at va.
+// The pages are flagged PTE_SHM so that fork shares them instead of
+// copying them (see shmcopy). Returns 0, or -1 with nothing left mapped.
+int
+shmmap(pagetable_t pagetable, uint64 va, int npages)
+{
+  int i;
+  char *mem;
+
+  for (i = 0; i < npages; i++) {
+    if ((mem = kalloc()) == 0)
+      goto err;
+    memset(mem, 0, PGSIZE);
+    if (mappages(pagetable, va + i * PGSIZE, PGSIZE, (uint64)mem,
+                 PTE_R | PTE_W | PTE_U | PTE_SHM) != 0) {
+      kfree(mem);
+      goto err;
+    }
+  }
+  return 0;
+
+err:
+  uvmunmap(pagetable, va, i, 1);
+  return -1;
+}
+
+// fork() helper: map the parent's shared window into the child, pointing at
+// the same physical pages (one extra reference each). The window is
+// [SHMTOP - shmsz, SHMTOP) and has no holes by construction.
+// Returns 0, or -1 with the child's part of the window unmapped again.
+int
+shmcopy(pagetable_t old, pagetable_t new, uint64 shmsz)
+{
+  uint64 base = SHMTOP - shmsz;
+  uint64 a, pa;
+  pte_t *pte;
+
+  for (a = base; a < SHMTOP; a += PGSIZE) {
+    pte = walk(old, a, 0);
+    if (pte == 0 || (*pte & PTE_V) == 0 || (*pte & PTE_SHM) == 0)
+      panic("shmcopy: hole in shared window");
+    pa = PTE2PA(*pte);
+    krefinc((void *)pa);
+    if (mappages(new, a, PGSIZE, pa, PTE_FLAGS(*pte)) != 0) {
+      kfree((void *)pa); // undo the reference taken above
+      goto err;
+    }
+  }
+  return 0;
+
+err:
+  uvmunmap(new, base, (a - base) / PGSIZE, 1);
+  return -1;
+}
+
+// Physical address behind user address va (page offset included), or 0.
+// Faults in a lazily allocated heap page the same way copyin() would.
+// The futex code keys its wait queues on this, so that two processes
+// looking at the same shared word agree on what it is called.
+uint64
+uva2pa(pagetable_t pagetable, uint64 psz, uint64 va)
+{
+  uint64 pa = walkaddr(pagetable, va);
+  if (pa == 0)
+    pa = vmfault(pagetable, psz, va, 1);
+  if (pa == 0)
+    return 0;
+  return pa + (va & (PGSIZE - 1));
+}
diff --git a/kernel/waitq.c b/kernel/waitq.c
new file mode 100644
index 0000000..24a1896
--- /dev/null
+++ b/kernel/waitq.c
@@ -0,0 +1,133 @@
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "riscv.h"
+#include "spinlock.h"
+#include "proc.h"
+#include "defs.h"
+#include "waitq.h"
+
+// Everything here is called with the lock that protects the queue held.
+// That lock belongs to the caller (the semaphore, the condvar, the futex
+// bucket); waitq.c never takes a lock of its own.
+
+void
+wq_init(struct waitq *q)
+{
+  q->head.next = q->head.prev = &q->head;
+}
+
+int
+wq_empty(struct waitq *q)
+{
+  return q->head.next == &q->head;
+}
+
+// Put w at the tail of q.
+void
+wq_enqueue(struct waitq *q, struct waiter *w, uint64 key)
+{
+  w->key = key;
+  w->signaled = 0;
+  w->prev = q->head.prev;
+  w->next = &q->head;
+  q->head.prev->next = w;
+  q->head.prev = w;
+}
+
+static void
+wq_unlink(struct waiter *w)
+{
+  w->prev->next = w->next;
+  w->next->prev = w->prev;
+  w->prev = w->next = 0;
+}
+
+// Take w off its queue, mark it, and make its process runnable.
+static void
+wq_signal(struct waiter *w)
+{
+  wq_unlink(w);
+  w->signaled = 1;
+  wakeup(w);
+}
+
+// Block the calling process until another process signals w.
+// w must already be on a queue, and lk (the lock protecting that queue)
+// must be held. lk is released while we sleep and held again on return.
+//
+// Returns 0 once w was signaled, or -1 if the process was killed first
+// (w is off the queue in both cases).
+//
+// This is sleep() written out by hand, with one addition. kill() only
+// wakes a process that is already SLEEPING. If the kill lands after we
+// let go of lk but before we are asleep, plain sleep() would go to sleep
+// anyway and the process would stay blocked until the next real wakeup,
+// possibly forever. So we look at p->killed with p->lock held, the same
+// lock kill() takes, and refuse to sleep if the flag is already up.
+int
+wq_block(struct waiter *w, struct spinlock *lk)
+{
+  struct proc *p = myproc();
+  int dying;
+
+  while (!w->signaled) {
+    acquire(&p->lock);
+    release(lk);
+
+    dying = p->killed;
+    if (!dying) {
+      p->chan = w;
+      p->state = SLEEPING;
+      sched();
+      p->chan = 0;
+      dying = p->killed;
+    }
+
+    release(&p->lock);
+    acquire(lk);
+
+    // A wakeup that raced with the kill wins: the waker already took us
+    // off the queue and handed us whatever we were waiting for.
+    if (dying && !w->signaled) {
+      wq_unlink(w);
+      return -1;
+    }
+  }
+  return 0;
+}
+
+// Wake the first n waiters, in arrival order. n < 0 means everybody.
+// Returns how many were woken.
+int
+wq_wake(struct waitq *q, int n)
+{
+  int woken = 0;
+
+  while (n != 0 && !wq_empty(q)) {
+    wq_signal(q->head.next);
+    woken++;
+    if (n > 0)
+      n--;
+  }
+  return woken;
+}
+
+// Same, but only for waiters whose key matches (futexes share buckets).
+int
+wq_wake_key(struct waitq *q, uint64 key, int n)
+{
+  struct waiter *w, *next;
+  int woken = 0;
+
+  for (w = q->head.next; w != &q->head && n != 0; w = next) {
+    next = w->next; // wq_signal() unlinks w
+    if (w->key == key) {
+      wq_signal(w);
+      woken++;
+      if (n > 0)
+        n--;
+    }
+  }
+  return woken;
+}
diff --git a/kernel/waitq.h b/kernel/waitq.h
new file mode 100644
index 0000000..8780a1c
--- /dev/null
+++ b/kernel/waitq.h
@@ -0,0 +1,26 @@
+// FIFO wait queues, the common plumbing under semaphores, condition
+// variables and futexes (see waitq.c).
+//
+// A waiter node lives on the kernel stack of the process that is blocked,
+// so it costs nothing to allocate and can never run out. The price is that
+// it must be off the queue before the blocking function returns. wq_block()
+// and the wake functions take care of that.
+
+struct spinlock;
+
+struct waiter {
+  struct waiter *prev, *next;
+  uint64 key;     // for the owner of the queue; futexes store the word's PA
+  int signaled;   // set by whoever wakes us. This is the wakeup condition.
+};
+
+struct waitq {
+  struct waiter head; // circular list, head is the sentinel
+};
+
+void wq_init(struct waitq *);
+int  wq_empty(struct waitq *);
+void wq_enqueue(struct waitq *, struct waiter *, uint64 key);
+int  wq_block(struct waiter *, struct spinlock *);
+int  wq_wake(struct waitq *, int n);
+int  wq_wake_key(struct waitq *, uint64 key, int n);
diff --git a/test-p5.py b/test-p5.py
new file mode 100755
index 0000000..af0cfe7
--- /dev/null
+++ b/test-p5.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+# Boot xv6 under qemu, type some commands at the shell, show what came back.
+#
+#   ./test-p5.py p5test                 run the whole suite
+#   ./test-p5.py "semtest" "philo order"   run these, in order
+#
+# Exit status is 0 only if every command printed its PASS line.
+# CPUS=1 ./test-p5.py ...  runs on a single hart.
+
+import os, subprocess, sys, time, select, re
+
+CPUS = os.environ.get("CPUS", "3")
+TIMEOUT = int(os.environ.get("TIMEOUT", "240"))
+
+def main():
+    cmds = sys.argv[1:] or ["p5test"]
+    q = subprocess.Popen(
+        ["make", "-s", "qemu", "CPUS=" + CPUS],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+        bufsize=0)
+    buf = b""
+    def pump(until, limit):
+        nonlocal buf
+        end = time.time() + limit
+        while time.time() < end:
+            r, _, _ = select.select([q.stdout], [], [], 0.2)
+            if r:
+                d = os.read(q.stdout.fileno(), 4096)
+                if not d:
+                    return False
+                buf += d
+                sys.stdout.write(d.decode(errors="replace"))
+                sys.stdout.flush()
+                if until in buf:
+                    return True
+        return False
+
+    ok = pump(b"init: starting sh", 60) and pump(b"$ ", 30)
+    if not ok:
+        print("\n*** xv6 did not boot")
+        q.kill()
+        return 2
+    status = 0
+    for c in cmds:
+        buf = b""
+        q.stdin.write(c.encode() + b"\n")
+        q.stdin.flush()
+        if not pump(b"\n$ ", TIMEOUT):
+            print("\n*** timeout waiting for: " + c)
+            status = 1
+            break
+        if b"PASS" not in buf or b"FAIL" in buf or b"panic" in buf:
+            status = 1
+    q.stdin.write(b"\x01x")
+    q.stdin.flush()
+    try:
+        q.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        q.kill()
+    print("\n=== %s ===" % ("PASSED" if status == 0 else "FAILED"))
+    return status
+
+sys.exit(main())
diff --git a/user/condtest.c b/user/condtest.c
new file mode 100644
index 0000000..b7db92a
--- /dev/null
+++ b/user/condtest.c
@@ -0,0 +1,219 @@
+// Unit tests for the kernel condition variables.
+// The mutex is a binary semaphore, as cond_wait() expects.
+
+#include "kernel/types.h"
+#include "kernel/param.h"
+#include "user/user.h"
+#include "user/ptest.h"
+
+static int *sh;   // sh[0] woken, sh[1] log position, sh[2..] log, sh[40] ping-pong turn
+
+static int mu, cv; // handles, inherited by the children
+
+static void
+waiter(int id)
+{
+  if (sem_wait(mu) < 0)
+    exit(1);
+  // predicate: sh[3] != 0, set by the parent. Loop because of Mesa semantics.
+  while (sh[3] == 0)
+    if (cond_wait(cv, mu) < 0)
+      exit(1);
+  int slot = __atomic_fetch_add(&sh[1], 1, __ATOMIC_SEQ_CST);
+  sh[8 + slot] = id;
+  __atomic_fetch_add(&sh[0], 1, __ATOMIC_SEQ_CST);
+  sem_post(mu);
+}
+
+// Variant where a signal consumes the predicate, so that exactly one
+// waiter can proceed per signal.
+static void
+ticket_waiter(int id)
+{
+  if (sem_wait(mu) < 0)
+    exit(1);
+  while (sh[3] == 0)
+    if (cond_wait(cv, mu) < 0)
+      exit(1);
+  sh[3]--;
+  int slot = __atomic_fetch_add(&sh[1], 1, __ATOMIC_SEQ_CST);
+  sh[8 + slot] = id;
+  __atomic_fetch_add(&sh[0], 1, __ATOMIC_SEQ_CST);
+  sem_post(mu);
+}
+
+static void
+reset(void)
+{
+  sh[0] = sh[1] = sh[3] = 0;
+}
+
+static void
+test_misuse(void)
+{
+  int m = sem_init(1), c = cond_init();
+  CHECK(c >= 0 && m >= 0, "init");
+  CHECK(cond_wait(c, m) == -1, "cond_wait with an unlocked mutex is refused");
+  CHECK(cond_wait(-1, m) == -1, "bad condvar handle");
+  CHECK(cond_wait(c, 99) == -1, "bad mutex handle");
+  CHECK(cond_signal(NCOND) == -1, "signal on bad handle");
+  CHECK(cond_broadcast(-3) == -1, "broadcast on bad handle");
+  CHECK(cond_signal(c) == 0, "signal with nobody waiting is fine");
+  CHECK(cond_destroy(c) == 0, "destroy");
+  CHECK(cond_destroy(c) == -1, "destroy twice");
+  CHECK(cond_signal(c) == -1, "signal after destroy");
+  sem_destroy(m);
+}
+
+static void
+test_table_full(void)
+{
+  int h[NCOND + 1], n = 0, i;
+  while (n <= NCOND && (h[n] = cond_init()) >= 0)
+    n++;
+  CHECK(n == NCOND, "exactly NCOND condvars");
+  for (i = 0; i < n; i++)
+    cond_destroy(h[i]);
+  CHECK((h[0] = cond_init()) >= 0, "slot free again");
+  cond_destroy(h[0]);
+}
+
+static void
+test_signal_one(void)
+{
+  int i;
+  mu = sem_init(1);
+  cv = cond_init();
+  reset();
+  for (i = 0; i < 3; i++) {
+    spawn(ticket_waiter, i);
+    nap(2); // arrival order 0, 1, 2
+  }
+  CHECK(sh[0] == 0, "nobody got through yet");
+
+  for (i = 1; i <= 3; i++) {
+    sem_wait(mu);
+    sh[3] = 1;                  // one ticket
+    cond_signal(cv);
+    sem_post(mu);
+    nap(2);
+    CHECK(sh[0] == i, "each signal releases exactly one waiter");
+  }
+  CHECK(reap() == 0, "waiters finished");
+  for (i = 0; i < 3; i++)
+    CHECK(sh[8 + i] == i, "signals wake the oldest waiter first");
+  sem_destroy(mu);
+  cond_destroy(cv);
+}
+
+static void
+test_broadcast(void)
+{
+  int i;
+  mu = sem_init(1);
+  cv = cond_init();
+  reset();
+  for (i = 0; i < 5; i++)
+    spawn(waiter, i);
+  nap(4);
+  CHECK(sh[0] == 0, "all five are asleep");
+  sem_wait(mu);
+  sh[3] = 1;
+  cond_broadcast(cv);
+  sem_post(mu);
+  watchdog(100);
+  CHECK(reap() == 0, "waiters finished");
+  CHECK(sh[0] == 5, "broadcast woke everybody");
+  CHECK(sem_getvalue(mu) == 1, "mutex is free at the end");
+  sem_destroy(mu);
+  cond_destroy(cv);
+}
+
+static void
+test_signal_not_remembered(void)
+{
+  mu = sem_init(1);
+  cv = cond_init();
+  reset();
+  // a signal nobody hears is gone; it must not wake a later waiter
+  cond_signal(cv);
+  spawn(ticket_waiter, 0);
+  nap(3);
+  CHECK(sh[0] == 0, "late waiter still blocked");
+  sem_wait(mu);
+  sh[3] = 1;
+  cond_signal(cv);
+  sem_post(mu);
+  watchdog(100);
+  CHECK(reap() == 0, "waiter finished");
+  CHECK(sh[0] == 1, "and the real signal woke it");
+  sem_destroy(mu);
+  cond_destroy(cv);
+}
+
+static void
+test_kill_waiter(void)
+{
+  mu = sem_init(1);
+  cv = cond_init();
+  reset();
+  int pid = spawn(waiter, 0);
+  nap(3);
+  CHECK(sem_getvalue(mu) == 1, "cond_wait gave the mutex back");
+  CHECK(kill_and_wait(pid) == -1, "killed");
+  // dead waiter must be off the queue: a broadcast must not trip on it
+  CHECK(cond_broadcast(cv) == 0, "broadcast after the kill");
+  CHECK(sem_trywait(mu) == 0, "mutex is still usable");
+  sem_post(mu);
+  sem_destroy(mu);
+  cond_destroy(cv);
+}
+
+// two processes take turns through one condvar; any lost wakeup hangs
+static void
+pinger(int me)
+{
+  for (int i = 0; i < 300; i++) {
+    sem_wait(mu);
+    while (sh[40] != me)
+      cond_wait(cv, mu);
+    sh[41]++;
+    sh[40] = 1 - me;
+    cond_broadcast(cv);
+    sem_post(mu);
+  }
+}
+
+static void
+test_pingpong(void)
+{
+  mu = sem_init(1);
+  cv = cond_init();
+  sh[40] = 0;
+  sh[41] = 0;
+  spawn(pinger, 0);
+  spawn(pinger, 1);
+  watchdog(300);
+  CHECK(reap() == 0, "both finished");
+  CHECK(sh[41] == 600, "every turn was taken");
+  sem_destroy(mu);
+  cond_destroy(cv);
+}
+
+#define RUN(t) do { printf("  %s ... ", #t); t(); printf("ok\n"); } while (0)
+
+int
+main(void)
+{
+  sh = shm_ints(1);
+  printf("condtest\n");
+  RUN(test_misuse);
+  RUN(test_table_full);
+  RUN(test_signal_one);
+  RUN(test_broadcast);
+  RUN(test_signal_not_remembered);
+  RUN(test_kill_waiter);
+  RUN(test_pingpong);
+  printf("condtest: PASS\n");
+  exit(0);
+}
diff --git a/user/futextest.c b/user/futextest.c
new file mode 100644
index 0000000..3e973e2
--- /dev/null
+++ b/user/futextest.c
@@ -0,0 +1,222 @@
+// Unit tests for futex_wait/futex_wake and the futex-based user library.
+
+#include "kernel/types.h"
+#include "kernel/param.h"
+#include "user/user.h"
+#include "user/usync.h"
+#include "user/ptest.h"
+
+static int *w;   // futex words live in shared memory
+static int priv; // a private word, to show that keys are physical
+
+static void
+sleeper(int id)
+{
+  int r = futex_wait(&w[0], 0);
+  if (r != 0)
+    exit(1);
+  int slot = __atomic_fetch_add(&w[1], 1, __ATOMIC_SEQ_CST);
+  w[2 + slot] = id;
+}
+
+static void
+test_errors(void)
+{
+  w[0] = 5;
+  CHECK(futex_wait(&w[0], 4) == 1, "value mismatch returns at once");
+  CHECK(futex_wait((int *)((char *)&w[0] + 1), 5) == -1, "unaligned address");
+  CHECK(futex_wait((int *)0x3fffff0000L, 0) == -1, "unmapped address");
+  CHECK(futex_wait((int *)0x80000000L, 0) == -1, "kernel address");
+  CHECK(futex_wake((int *)((char *)&w[0] + 2), 1) == -1, "unaligned wake");
+  CHECK(futex_wake((int *)0x3fffff0000L, 1) == -1, "wake on unmapped address");
+  CHECK(futex_wake(&w[0], 1) == 0, "wake with nobody asleep");
+  CHECK(futex_wake(&w[0], -1) == 0, "wake all with nobody asleep");
+}
+
+static void
+test_wake_counts(void)
+{
+  int i;
+  w[0] = 0;
+  w[1] = 0;
+  for (i = 0; i < 5; i++) {
+    spawn(sleeper, i);
+    nap(2);
+  }
+  CHECK(futex_wake(&w[0], 1) == 1, "wake(1) wakes one");
+  nap(2);
+  CHECK(w[1] == 1, "one process ran");
+  CHECK(futex_wake(&w[0], 2) == 2, "wake(2) wakes two");
+  nap(2);
+  CHECK(w[1] == 3, "three have run");
+  CHECK(futex_wake(&w[0], 0) == 0, "wake(0) wakes nobody");
+  CHECK(futex_wake(&w[0], 100) == 2, "wake(100) wakes the rest, and reports 2");
+  CHECK(reap() == 0, "sleepers finished");
+  for (i = 0; i < 5; i++)
+    CHECK(w[2 + i] == i, "woken oldest first");
+  CHECK(futex_wake(&w[0], 1) == 0, "queue is empty now");
+}
+
+static void
+test_other_word(void)
+{
+  // different word in the same page: must not be woken by a wake on its neighbour
+  w[0] = 0;
+  w[1] = 0;
+  int pid = spawn(sleeper, 7);
+  nap(2);
+  CHECK(futex_wake(&w[16], 1) == 0, "wake on a different word hits nothing");
+  nap(1);
+  CHECK(w[1] == 0, "sleeper is still asleep");
+  CHECK(futex_wake(&w[0], 1) == 1, "wake on its own word works");
+  CHECK(reap() == 0, "sleeper finished");
+  (void)pid;
+}
+
+static void
+private_sleeper(int arg)
+{
+  priv = 0;
+  futex_wait(&priv, 0);
+  exit(5); // reached only if somebody wakes us
+}
+
+static void
+test_private_is_private(void)
+{
+  // Child sleeps on &priv in its own address space. We have a variable at
+  // the same virtual address, but it's a different physical page.
+  int pid = spawn(private_sleeper, 0);
+  nap(2);
+  CHECK(futex_wake(&priv, 10) == 0, "same VA, other process: not the same futex");
+  CHECK(kill_and_wait(pid) == -1, "sleeper was still asleep, and dies on kill");
+}
+
+static void
+test_kill_sleeper(void)
+{
+  w[0] = 0;
+  w[1] = 0;
+  int pid = spawn(sleeper, 1);
+  nap(2);
+  CHECK(kill_and_wait(pid) == -1, "killed");
+  CHECK(futex_wake(&w[0], 10) == 0, "dead sleeper is not on the queue any more");
+}
+
+static void
+parent_wakes_child_side(int arg)
+{
+  // child sets the word and wakes the parent
+  nap(2);
+  __atomic_store_n(&w[0], 1, __ATOMIC_SEQ_CST);
+  futex_wake(&w[0], 1);
+}
+
+static void
+test_cross_process(void)
+{
+  w[0] = 0;
+  spawn(parent_wakes_child_side, 0);
+  while (__atomic_load_n(&w[0], __ATOMIC_SEQ_CST) == 0)
+    futex_wait(&w[0], 0);
+  CHECK(reap() == 0, "child finished");
+}
+
+static fmutex_t *fm;
+static int *count;
+
+static void
+fm_worker(int arg)
+{
+  for (int i = 0; i < 500; i++) {
+    fmutex_lock(fm);
+    int t = *count;
+    spin(10);
+    *count = t + 1;
+    fmutex_unlock(fm);
+  }
+}
+
+static void
+test_fmutex(void)
+{
+  int i;
+  *count = 0;
+  for (i = 0; i < 4; i++)
+    spawn(fm_worker, 0);
+  watchdog(300);
+  CHECK(reap() == 0, "workers finished");
+  CHECK(*count == 2000, "futex mutex: no lost updates");
+  CHECK(fmutex_trylock(fm) == 0, "trylock on a free mutex");
+  CHECK(fmutex_trylock(fm) == -1, "trylock on a held mutex");
+  fmutex_unlock(fm);
+}
+
+static fcond_t *fc;
+
+static void
+fc_producer(int arg)
+{
+  for (int i = 1; i <= 400; i++) {
+    fmutex_lock(fm);
+    while (count[1] != 0)       // one-slot mailbox
+      fcond_wait(fc, fm);
+    count[1] = i;
+    fcond_broadcast(fc);
+    fmutex_unlock(fm);
+  }
+}
+
+static void
+fc_consumer(int arg)
+{
+  long sum = 0;
+  for (int i = 1; i <= 400; i++) {
+    fmutex_lock(fm);
+    while (count[1] == 0)
+      fcond_wait(fc, fm);
+    sum += count[1];
+    count[1] = 0;
+    fcond_broadcast(fc);
+    fmutex_unlock(fm);
+  }
+  count[2] = (int)sum;
+}
+
+static void
+test_fcond(void)
+{
+  count[1] = 0;
+  count[2] = 0;
+  spawn(fc_producer, 0);
+  spawn(fc_consumer, 0);
+  watchdog(300);
+  CHECK(reap() == 0, "both finished");
+  CHECK(count[2] == 400 * 401 / 2, "mailbox handed over every value exactly once");
+}
+
+#define RUN(t) do { printf("  %s ... ", #t); t(); printf("ok\n"); } while (0)
+
+int
+main(void)
+{
+  char *mem = (char *)shm_ints(1);
+  w = (int *)mem;                              // first half: futex words
+  fm = (fmutex_t *)(mem + 2048);
+  fc = (fcond_t *)(mem + 2048 + 64);
+  count = (int *)(mem + 2048 + 128);
+  fmutex_init(fm);
+  fcond_init(fc);
+
+  printf("futextest\n");
+  RUN(test_errors);
+  RUN(test_wake_counts);
+  RUN(test_other_word);
+  RUN(test_private_is_private);
+  RUN(test_kill_sleeper);
+  RUN(test_cross_process);
+  RUN(test_fmutex);
+  RUN(test_fcond);
+  printf("futextest: PASS\n");
+  exit(0);
+}
diff --git a/user/hotlocks.c b/user/hotlocks.c
new file mode 100644
index 0000000..7b518e9
--- /dev/null
+++ b/user/hotlocks.c
@@ -0,0 +1,233 @@
+// Kernel lock-contention profiler CLI and analysis tool.
+//
+// Usage:
+//   hotlocks                  run multi-core benchmark and find hot locks
+//   hotlocks dump             display current lock stats without resetting
+//   hotlocks raw              display per-spinlock unaggregated stats
+//   hotlocks reset            reset all lock contention counters
+//   hotlocks <prog> [args...] profile a specific command (e.g. hotlocks p5test)
+
+#include "kernel/types.h"
+#include "kernel/param.h"
+#include "kernel/stat.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+#define MAX_ENTRIES 64
+
+static void
+print_stat_row(struct lock_stat *s)
+{
+  uint64 cont_pct_int = 0;
+  uint64 cont_pct_frac = 0;
+  uint64 avg_spin_int = 0;
+  uint64 avg_spin_frac = 0;
+
+  if (s->n_acq > 0) {
+    uint64 pct10 = (s->n_contended * 1000) / s->n_acq;
+    cont_pct_int = pct10 / 10;
+    cont_pct_frac = pct10 % 10;
+  }
+  if (s->n_contended > 0) {
+    uint64 avg10 = (s->n_spins * 10) / s->n_contended;
+    avg_spin_int = avg10 / 10;
+    avg_spin_frac = avg10 % 10;
+  }
+
+  // Format columns: Name (12) | Acquires (10) | Contended (10) | Cont% (7) | Total Spins (12) | Avg Spins/Cont (14)
+  printf("%s", s->name);
+  int len = strlen(s->name);
+  for (int i = len; i < 14; i++)
+    printf(" ");
+
+  printf("%d", (int)s->n_acq);
+  // Pad acquisitions
+  int acq_digits = 1;
+  uint64 t = s->n_acq;
+  while (t >= 10) { acq_digits++; t /= 10; }
+  for (int i = acq_digits; i < 12; i++) printf(" ");
+
+  printf("%d", (int)s->n_contended);
+  int cont_digits = 1;
+  t = s->n_contended;
+  while (t >= 10) { cont_digits++; t /= 10; }
+  for (int i = cont_digits; i < 12; i++) printf(" ");
+
+  printf("%d.%d%%", (int)cont_pct_int, (int)cont_pct_frac);
+  int pct_len = 4 + (cont_pct_int >= 10 ? 1 : 0) + (cont_pct_int >= 100 ? 1 : 0);
+  for (int i = pct_len; i < 10; i++) printf(" ");
+
+  printf("%d", (int)s->n_spins);
+  int spin_digits = 1;
+  t = s->n_spins;
+  while (t >= 10) { spin_digits++; t /= 10; }
+  for (int i = spin_digits; i < 14; i++) printf(" ");
+
+  printf("%d.%d\n", (int)avg_spin_int, (int)avg_spin_frac);
+}
+
+static void
+sort_stats(struct lock_stat *stats, int n)
+{
+  for (int i = 0; i < n - 1; i++) {
+    for (int j = 0; j < n - i - 1; j++) {
+      if (stats[j].n_spins < stats[j + 1].n_spins ||
+          (stats[j].n_spins == stats[j + 1].n_spins && stats[j].n_contended < stats[j + 1].n_contended)) {
+        struct lock_stat tmp = stats[j];
+        stats[j] = stats[j + 1];
+        stats[j + 1] = tmp;
+      }
+    }
+  }
+}
+
+static void
+display_stats(int mode)
+{
+  struct lock_stat stats[MAX_ENTRIES];
+  int n = lockstat(stats, MAX_ENTRIES, mode);
+  if (n < 0) {
+    printf("hotlocks: lockstat failed\n");
+    return;
+  }
+
+  sort_stats(stats, n);
+
+  printf("\n======================== XV6 LOCK CONTENTION PROFILER ========================\n");
+  printf("LOCK NAME     ACQUIRES    CONTENDED   CONT RATE   TOTAL SPINS   AVG SPINS/CONT\n");
+  printf("------------------------------------------------------------------------------\n");
+
+  int hot_count = 0;
+  for (int i = 0; i < n; i++) {
+    if (stats[i].n_acq > 0 || stats[i].n_spins > 0) {
+      print_stat_row(&stats[i]);
+      if (stats[i].n_spins > 0)
+        hot_count++;
+    }
+  }
+  printf("------------------------------------------------------------------------------\n");
+
+  printf("\n=== Analysis of Hot Locks in xv6 ===\n");
+  for (int i = 0; i < n && i < 4; i++) {
+    if (stats[i].n_spins == 0)
+      continue;
+    if (strcmp(stats[i].name, "kmem") == 0) {
+      printf("[*] 'kmem' (Memory Allocator): Heavy contention due to single global freelist lock.\n"
+             "    Concurrent page allocations (fork, exec, sbrk) on multiple CPUs fight for this lock.\n");
+    } else if (strcmp(stats[i].name, "bcache") == 0) {
+      printf("[*] 'bcache' (Buffer Cache): Contention from concurrent block reads/writes.\n"
+             "    A single lock protects all buffer headers and the LRU list.\n");
+    } else if (strcmp(stats[i].name, "wait_lock") == 0 || strcmp(stats[i].name, "proc") == 0) {
+      printf("[*] '%s' (Process Management): Contention during concurrent fork/exit/wait\n"
+             "    and process table state transitions.\n", stats[i].name);
+    } else if (strcmp(stats[i].name, "futex") == 0 || strcmp(stats[i].name, "sem") == 0 || strcmp(stats[i].name, "semtab") == 0) {
+      printf("[*] '%s' (Sync Primitives): Contention from concurrent waiter queues.\n", stats[i].name);
+    }
+  }
+  if (hot_count == 0) {
+    printf("(No lock spin contention observed in this run - single CPU or uncontended locks)\n");
+  }
+  printf("==============================================================================\n\n");
+}
+
+static void
+run_stress_workload(void)
+{
+  int nworkers = 4;
+  printf("hotlocks: running multi-core workload across %d worker processes...\n", nworkers);
+
+  for (int w = 0; w < nworkers; w++) {
+    int pid = fork();
+    if (pid < 0) {
+      printf("hotlocks: fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      // Workload 1: Memory allocator stress (kmem lock)
+      for (int i = 0; i < 300; i++) {
+        char *p = sbrk(4096);
+        if (p != (char *)-1) {
+          p[0] = (char)i;
+          sbrk(-4096);
+        }
+      }
+
+      // Workload 2: Filesystem buffer cache stress (bcache / itable)
+      char fname[16];
+      fname[0] = 'l'; fname[1] = 'k'; fname[2] = '0' + w; fname[3] = '\0';
+      for (int i = 0; i < 20; i++) {
+        int fd = open(fname, O_CREATE | O_RDWR);
+        if (fd >= 0) {
+          write(fd, "test", 4);
+          close(fd);
+          unlink(fname);
+        }
+      }
+
+      // Workload 3: Short fork/exit (proc and wait_lock)
+      for (int i = 0; i < 8; i++) {
+        int k = fork();
+        if (k == 0) exit(0);
+        wait(0);
+      }
+
+      exit(0);
+    }
+  }
+
+  for (int w = 0; w < nworkers; w++) {
+    wait(0);
+  }
+  printf("hotlocks: workload completed.\n");
+}
+
+int
+main(int argc, char *argv[])
+{
+  if (argc == 2 && strcmp(argv[1], "reset") == 0) {
+    if (lockstat(0, 0, LOCKSTAT_RESET) == 0)
+      printf("hotlocks: lock contention counters reset to zero.\n");
+    else
+      printf("hotlocks: reset failed.\n");
+    exit(0);
+  }
+
+  if (argc == 2 && strcmp(argv[1], "dump") == 0) {
+    display_stats(LOCKSTAT_AGGREGATE);
+    exit(0);
+  }
+
+  if (argc == 2 && strcmp(argv[1], "raw") == 0) {
+    display_stats(LOCKSTAT_RAW);
+    exit(0);
+  }
+
+  if (argc >= 2) {
+    // Run custom command with profiling
+    printf("hotlocks: resetting counters and profiling command '%s'...\n", argv[1]);
+    lockstat(0, 0, LOCKSTAT_RESET);
+
+    int pid = fork();
+    if (pid < 0) {
+      printf("hotlocks: fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      exec(argv[1], &argv[1]);
+      printf("hotlocks: cannot exec %s\n", argv[1]);
+      exit(1);
+    }
+    int status = 0;
+    wait(&status);
+    printf("\nhotlocks: target program exited with status %d\n", status);
+    display_stats(LOCKSTAT_AGGREGATE);
+    exit(status);
+  }
+
+  // Default: reset, run workload, show hot locks
+  lockstat(0, 0, LOCKSTAT_RESET);
+  run_stress_workload();
+  display_stats(LOCKSTAT_AGGREGATE);
+  printf("hotlocks: PASS\n");
+  exit(0);
+}
diff --git a/user/locktest.c b/user/locktest.c
new file mode 100644
index 0000000..a4bf6c4
--- /dev/null
+++ b/user/locktest.c
@@ -0,0 +1,85 @@
+// Unit tests for the kernel lock-contention profiler system call (lockstat).
+
+#include "kernel/types.h"
+#include "kernel/param.h"
+#include "user/user.h"
+#include "user/ptest.h"
+
+static void
+test_bad_args(void)
+{
+  CHECK(lockstat(0, 0, 0) == -1, "null pointer without reset flag returns -1");
+  CHECK(lockstat((void *)-1, 10, 0) == -1, "invalid pointer returns -1");
+  CHECK(lockstat((void *)0x1, 10, 0) == -1, "unaligned bad pointer returns -1");
+}
+
+static void
+test_reset_and_read(void)
+{
+  struct lock_stat stats[32];
+
+  CHECK(lockstat(0, 0, LOCKSTAT_RESET) == 0, "reset counters succeeds");
+
+  int n = lockstat(stats, 32, LOCKSTAT_AGGREGATE);
+  CHECK(n > 0, "aggregated read returns entries");
+
+  int found_named = 0;
+  for (int i = 0; i < n; i++) {
+    if (strlen(stats[i].name) > 0)
+      found_named++;
+  }
+  CHECK(found_named > 0, "found valid lock names");
+}
+
+static void
+worker_contention(int id)
+{
+  // Allocate and free memory rapidly to hammer kmem.lock
+  for (int i = 0; i < 200; i++) {
+    char *p = sbrk(4096);
+    if (p != SBRK_ERROR) {
+      p[0] = (char)id;
+      sbrk(-4096);
+    }
+  }
+}
+
+static void
+test_contention_capture(void)
+{
+  struct lock_stat stats[32];
+
+  // Reset counters
+  CHECK(lockstat(0, 0, LOCKSTAT_RESET) == 0, "reset before workload");
+
+  // Spawn concurrent workers to generate real lock contention on kmem
+  for (int i = 0; i < 4; i++) {
+    spawn(worker_contention, i);
+  }
+  reap();
+
+  int n = lockstat(stats, 32, LOCKSTAT_AGGREGATE);
+  CHECK(n > 0, "read stats after workload");
+
+  uint64 total_acq = 0;
+  for (int i = 0; i < n; i++) {
+    total_acq += stats[i].n_acq;
+  }
+  CHECK(total_acq > 0, "acquisitions recorded during workload");
+
+  // Raw per-spinlock mode check
+  struct lock_stat raw_stats[64];
+  int nraw = lockstat(raw_stats, 64, LOCKSTAT_RAW);
+  CHECK(nraw > 0, "raw mode returns individual lock entries");
+}
+
+int
+main(void)
+{
+  test_bad_args();
+  test_reset_and_read();
+  test_contention_capture();
+
+  printf("locktest: PASS\n");
+  exit(0);
+}
diff --git a/user/p5test.c b/user/p5test.c
new file mode 100644
index 0000000..dfecc4d
--- /dev/null
+++ b/user/p5test.c
@@ -0,0 +1,48 @@
+// Runs the whole project 5 suite, one program after the other, and says
+// at the end whether everything passed.
+
+#include "kernel/types.h"
+#include "user/user.h"
+
+static char *suite[][4] = {
+  { "semtest", 0 },
+  { "condtest", 0 },
+  { "futextest", 0 },
+  { "shmtest", 0 },
+  { "pcbuf", 0 },
+  { "rwlock", 0 },
+  { "philo", 0 },
+  { "philo", "naive", 0 },
+  { "locktest", 0 },
+};
+
+int
+main(void)
+{
+  int n = sizeof(suite) / sizeof(suite[0]), failed = 0;
+
+  for (int i = 0; i < n; i++) {
+    int pid = fork();
+    if (pid < 0) {
+      printf("p5test: fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      exec(suite[i][0], suite[i]);
+      printf("p5test: cannot exec %s\n", suite[i][0]);
+      exit(1);
+    }
+    int st;
+    wait(&st);
+    if (st != 0) {
+      printf("p5test: %s exited with status %d\n", suite[i][0], st);
+      failed++;
+    }
+  }
+
+  if (failed)
+    printf("p5test: %d of %d programs did not pass\n", failed, n);
+  else
+    printf("p5test: PASS (all %d programs)\n", n);
+  exit(failed != 0);
+}
diff --git a/user/pcbuf.c b/user/pcbuf.c
new file mode 100644
index 0000000..f8793f2
--- /dev/null
+++ b/user/pcbuf.c
@@ -0,0 +1,249 @@
+// Producer-consumer with a bounded buffer, solved three ways:
+//
+//   sem     three semaphores: empty slots, full slots, and a mutex
+//   cond    kernel condition variables (not-full, not-empty) + a semaphore mutex
+//   futex   the same shape on the user-level futex mutex and condvar
+//
+//   pcbuf                         all three with the defaults
+//   pcbuf sem|cond|futex [producers [consumers [items-per-producer]]]
+//
+// The buffer is deliberately tiny (4 slots) so that producers really have
+// to wait for consumers and the other way round. Every item has a unique
+// id; at the end each id must have been consumed exactly once, and each
+// consumer must have seen the items of one producer in increasing order.
+
+#include "kernel/types.h"
+#include "user/user.h"
+#include "user/usync.h"
+#include "user/ptest.h"
+
+#define BUFSZ    4
+#define MAXITEMS 1500
+#define MAXPROD  8
+
+struct shared {
+  int buf[BUFSZ];
+  int in, out, count;
+  int maxcount;           // fullest the buffer ever got
+  int seen[MAXITEMS];     // times each item id has been consumed
+  fmutex_t fm;            // futex mode only
+  fcond_t fnotfull, fnotempty;
+};
+
+static struct shared *S;
+static int mode;                 // 0 sem, 1 cond, 2 futex
+static int nprod, ncons, per_prod, per_cons;
+static int empty_s, full_s, mutex_s, notfull_c, notempty_c;
+
+// These two run with the buffer lock held, whatever kind of lock it is.
+static void
+buf_put(int item)
+{
+  S->buf[S->in] = item;
+  S->in = (S->in + 1) % BUFSZ;
+  S->count++;
+  CHECK(S->count <= BUFSZ, "buffer overflow");
+  if (S->count > S->maxcount)
+    S->maxcount = S->count;
+}
+
+static int
+buf_get(void)
+{
+  int item;
+
+  CHECK(S->count > 0, "buffer underflow");
+  item = S->buf[S->out];
+  S->out = (S->out + 1) % BUFSZ;
+  S->count--;
+  return item;
+}
+
+static void
+produce(int item)
+{
+  switch (mode) {
+  case 0:
+    sem_wait(empty_s);
+    sem_wait(mutex_s);
+    buf_put(item);
+    sem_post(mutex_s);
+    sem_post(full_s);
+    break;
+  case 1:
+    sem_wait(mutex_s);
+    while (S->count == BUFSZ)
+      cond_wait(notfull_c, mutex_s);
+    buf_put(item);
+    cond_signal(notempty_c);
+    sem_post(mutex_s);
+    break;
+  case 2:
+    fmutex_lock(&S->fm);
+    while (S->count == BUFSZ)
+      fcond_wait(&S->fnotfull, &S->fm);
+    buf_put(item);
+    fcond_signal(&S->fnotempty);
+    fmutex_unlock(&S->fm);
+    break;
+  }
+}
+
+static int
+consume(void)
+{
+  int item = -1;
+
+  switch (mode) {
+  case 0:
+    sem_wait(full_s);
+    sem_wait(mutex_s);
+    item = buf_get();
+    sem_post(mutex_s);
+    sem_post(empty_s);
+    break;
+  case 1:
+    sem_wait(mutex_s);
+    while (S->count == 0)
+      cond_wait(notempty_c, mutex_s);
+    item = buf_get();
+    cond_signal(notfull_c);
+    sem_post(mutex_s);
+    break;
+  case 2:
+    fmutex_lock(&S->fm);
+    while (S->count == 0)
+      fcond_wait(&S->fnotempty, &S->fm);
+    item = buf_get();
+    fcond_signal(&S->fnotfull);
+    fmutex_unlock(&S->fm);
+    break;
+  }
+  return item;
+}
+
+static void
+producer(int id)
+{
+  uint seed = 1000 + id;
+
+  for (int k = 0; k < per_prod; k++) {
+    spin(rnd(&seed) % 300);
+    produce(id * per_prod + k);
+  }
+}
+
+static void
+consumer(int id)
+{
+  uint seed = 5000 + id;
+  int last[MAXPROD];
+
+  for (int i = 0; i < MAXPROD; i++)
+    last[i] = -1;
+  for (int k = 0; k < per_cons; k++) {
+    spin(rnd(&seed) % 300);
+    int item = consume();
+    CHECK(item >= 0 && item < nprod * per_prod, "consumed garbage");
+    int p = item / per_prod;
+    CHECK(item > last[p], "one producer's items arrived out of order");
+    last[p] = item;
+    __atomic_fetch_add(&S->seen[item], 1, __ATOMIC_SEQ_CST);
+  }
+}
+
+static const char *names[] = { "sem", "cond", "futex" };
+
+static int
+run(int m)
+{
+  int i, total = nprod * per_prod;
+
+  mode = m;
+  memset(S, 0, sizeof(*S));
+  fmutex_init(&S->fm);
+  fcond_init(&S->fnotfull);
+  fcond_init(&S->fnotempty);
+  empty_s = sem_init(BUFSZ);
+  full_s = sem_init(0);
+  mutex_s = sem_init(1);
+  notfull_c = cond_init();
+  notempty_c = cond_init();
+  if (empty_s < 0 || full_s < 0 || mutex_s < 0 || notfull_c < 0 || notempty_c < 0) {
+    printf("pcbuf: out of kernel sync objects\n");
+    return 1;
+  }
+
+  for (i = 0; i < nprod; i++)
+    spawn(producer, i);
+  for (i = 0; i < ncons; i++)
+    spawn(consumer, i);
+  watchdog(600);
+  int bad = reap();
+
+  for (i = 0; i < total; i++)
+    if (S->seen[i] != 1) {
+      printf("pcbuf %s: item %d consumed %d times\n", names[m], i, S->seen[i]);
+      bad++;
+      break;
+    }
+  if (S->count != 0) {
+    printf("pcbuf %s: %d items left in the buffer\n", names[m], S->count);
+    bad++;
+  }
+
+  printf("pcbuf %s: %d producers, %d consumers, %d items, buffer peaked at %d/%d: %s\n",
+         names[m], nprod, ncons, total, S->maxcount, BUFSZ, bad ? "FAILED" : "ok");
+
+  sem_destroy(empty_s);
+  sem_destroy(full_s);
+  sem_destroy(mutex_s);
+  cond_destroy(notfull_c);
+  cond_destroy(notempty_c);
+  return bad != 0;
+}
+
+int
+main(int argc, char *argv[])
+{
+  int first = 0, last = 2, failed = 0;
+
+  nprod = 3;
+  ncons = 2;
+  per_prod = 120;  // 360 items; divisible by both 3 and 2 consumers
+  if (argc > 1) {
+    first = last = -1;
+    for (int i = 0; i < 3; i++)
+      if (strcmp(argv[1], names[i]) == 0)
+        first = last = i;
+    if (first < 0) {
+      fprintf(2, "usage: pcbuf [sem|cond|futex [producers [consumers [items]]]]\n");
+      exit(2);
+    }
+  }
+  if (argc > 2) nprod = atoi(argv[2]);
+  if (argc > 3) ncons = atoi(argv[3]);
+  if (argc > 4) per_prod = atoi(argv[4]);
+
+  if (nprod < 1 || nprod > MAXPROD || ncons < 1 || ncons > 16 ||
+      per_prod < 1 || nprod * per_prod > MAXITEMS ||
+      (nprod * per_prod) % ncons != 0) {
+    fprintf(2, "pcbuf: need 1..%d producers, 1..16 consumers, at most %d items in "
+            "total, and the total must divide evenly among the consumers\n",
+            MAXPROD, MAXITEMS);
+    exit(2);
+  }
+  per_cons = nprod * per_prod / ncons;
+
+  S = (struct shared *)shm_map((sizeof(struct shared) + 4095) / 4096);
+  if ((long)S == -1) {
+    printf("pcbuf: shm_map failed\n");
+    exit(1);
+  }
+
+  for (int m = first; m <= last; m++)
+    failed += run(m);
+
+  printf("pcbuf: %s\n", failed ? "FAILED" : "PASS");
+  exit(failed != 0);
+}
diff --git a/user/philo.c b/user/philo.c
new file mode 100644
index 0000000..2fff3fa
--- /dev/null
+++ b/user/philo.c
@@ -0,0 +1,276 @@
+// Dining philosophers: five of them, five chopsticks, each philosopher
+// needs the two next to him.
+//
+//   philo                      the four correct solutions, one after another
+//   philo MODE [-v]            one solution; -v prints who eats when
+//
+//   MODE:
+//     naive       pick up left, then right. Deadlocks, on purpose: the
+//                 philosophers pause between the two grabs so that it
+//                 happens every time. The test passes when it is detected.
+//     order       resource hierarchy: always take the lower-numbered
+//                 chopstick first, so no cycle of waiting can form
+//     room        a "waiter" semaphore lets at most four to the table, so
+//                 somebody can always get both chopsticks
+//     tanenbaum   the textbook state-array solution, one semaphore per
+//                 philosopher to sleep on, one mutex for the state
+//     monitor     the same idea written as a monitor: a mutex plus one
+//                 kernel condition variable per philosopher
+//
+// A shared array records who is eating at the moment. Two neighbours eating
+// together counts as a violation and fails the run.
+
+#include "kernel/types.h"
+#include "user/user.h"
+#include "user/ptest.h"
+
+#define N      5
+#define MEALS  20
+#define LEFT(i)  (((i) + N - 1) % N)
+#define RIGHT(i) (((i) + 1) % N)
+
+enum { THINKING, HUNGRY, EATING };
+enum { NAIVE, ORDER, ROOM, TANENBAUM, MONITOR };
+
+struct table {
+  int eating[N];
+  int meals[N];
+  int state[N];
+  int violations;
+  int done;
+};
+
+static struct table *T;
+static int mode, verbose;
+static int chop[N];          // one semaphore per chopstick
+static int room_s;           // seats, N-1 of them
+static int mutex_s;          // guards state[] (tanenbaum, monitor)
+static int self_s[N];        // tanenbaum: philosopher i sleeps here
+static int self_c[N];        // monitor: philosopher i waits on this condvar
+static int out_s;            // keeps -v lines from mixing
+
+static void
+say(int i, const char *what)
+{
+  if (!verbose)
+    return;
+  sem_wait(out_s);
+  printf("philosopher %d %s\n", i, what);
+  sem_post(out_s);
+}
+
+static void
+eat(int i, uint *seed)
+{
+  __atomic_store_n(&T->eating[i], 1, __ATOMIC_SEQ_CST);
+  // Set my own flag first, then look: if two neighbours ever eat together
+  // at least one of them is sure to see the other.
+  if (__atomic_load_n(&T->eating[LEFT(i)], __ATOMIC_SEQ_CST) ||
+      __atomic_load_n(&T->eating[RIGHT(i)], __ATOMIC_SEQ_CST))
+    __atomic_fetch_add(&T->violations, 1, __ATOMIC_SEQ_CST);
+  say(i, "is eating");
+  spin(rnd(seed) % 500);
+  T->meals[i]++;
+  __atomic_store_n(&T->eating[i], 0, __ATOMIC_SEQ_CST);
+}
+
+// tanenbaum / monitor helper, called with mutex_s held
+static void
+test(int i)
+{
+  if (T->state[i] == HUNGRY && T->state[LEFT(i)] != EATING &&
+      T->state[RIGHT(i)] != EATING) {
+    T->state[i] = EATING;
+    sem_post(self_s[i]);
+  }
+}
+
+static void
+pickup(int i)
+{
+  int a, b;
+
+  switch (mode) {
+  case NAIVE:
+    sem_wait(chop[i]);
+    nap(1);                       // everybody now holds their left one
+    sem_wait(chop[RIGHT(i)]);
+    break;
+  case ORDER:
+    a = i < RIGHT(i) ? i : RIGHT(i);
+    b = i < RIGHT(i) ? RIGHT(i) : i;
+    sem_wait(chop[a]);
+    sem_wait(chop[b]);
+    break;
+  case ROOM:
+    sem_wait(room_s);
+    sem_wait(chop[i]);
+    sem_wait(chop[RIGHT(i)]);
+    break;
+  case TANENBAUM:
+    sem_wait(mutex_s);
+    T->state[i] = HUNGRY;
+    test(i);
+    sem_post(mutex_s);
+    sem_wait(self_s[i]);
+    break;
+  case MONITOR:
+    sem_wait(mutex_s);
+    T->state[i] = HUNGRY;
+    while (T->state[LEFT(i)] == EATING || T->state[RIGHT(i)] == EATING)
+      cond_wait(self_c[i], mutex_s);
+    T->state[i] = EATING;
+    sem_post(mutex_s);
+    break;
+  }
+}
+
+static void
+putdown(int i)
+{
+  switch (mode) {
+  case NAIVE:
+  case ORDER:
+    sem_post(chop[i]);
+    sem_post(chop[RIGHT(i)]);
+    break;
+  case ROOM:
+    sem_post(chop[i]);
+    sem_post(chop[RIGHT(i)]);
+    sem_post(room_s);
+    break;
+  case TANENBAUM:
+    sem_wait(mutex_s);
+    T->state[i] = THINKING;
+    test(LEFT(i));
+    test(RIGHT(i));
+    sem_post(mutex_s);
+    break;
+  case MONITOR:
+    sem_wait(mutex_s);
+    T->state[i] = THINKING;
+    cond_signal(self_c[LEFT(i)]);
+    cond_signal(self_c[RIGHT(i)]);
+    sem_post(mutex_s);
+    break;
+  }
+}
+
+static void
+philosopher(int i)
+{
+  uint seed = 31 * i + 7;
+
+  for (int m = 0; m < MEALS; m++) {
+    say(i, "is thinking");
+    spin(rnd(&seed) % 700);
+    pickup(i);
+    eat(i, &seed);
+    putdown(i);
+  }
+  __atomic_fetch_add(&T->done, 1, __ATOMIC_SEQ_CST);
+}
+
+static const char *names[] = { "naive", "order", "room", "tanenbaum", "monitor" };
+
+static int
+run(int m)
+{
+  int i, bad = 0, waited = 0;
+
+  mode = m;
+  memset(T, 0, sizeof(*T));
+  for (i = 0; i < N; i++) {
+    chop[i] = sem_init(1);
+    self_s[i] = sem_init(0);
+    self_c[i] = cond_init();
+  }
+  room_s = sem_init(N - 1);
+  mutex_s = sem_init(1);
+  out_s = sem_init(1);
+  if (out_s < 0 || self_c[N - 1] < 0) {
+    printf("philo: out of kernel sync objects\n");
+    return 1;
+  }
+
+  for (i = 0; i < N; i++)
+    spawn(philosopher, i);
+
+  // Poll instead of just waiting, so that a deadlock gets noticed.
+  while (T->done < N && waited < 300) {
+    nap(1);
+    waited++;
+  }
+
+  if (T->done < N) {
+    for (i = 0; i < nkids; i++)
+      kill(kids[i]);
+    reap();
+    if (m == NAIVE) {
+      printf("philo naive: deadlock after %d of %d meals, as expected: PASS\n",
+             T->meals[0] + T->meals[1] + T->meals[2] + T->meals[3] + T->meals[4], N * MEALS);
+      bad = 0;
+    } else {
+      printf("philo %s: stuck, %d of %d philosophers finished: FAILED\n", names[m], T->done, N);
+      bad = 1;
+    }
+  } else {
+    bad = reap();
+    int lo = MEALS, hi = 0;
+    for (i = 0; i < N; i++) {
+      if (T->meals[i] < lo) lo = T->meals[i];
+      if (T->meals[i] > hi) hi = T->meals[i];
+    }
+    if (T->violations || lo != MEALS || hi != MEALS)
+      bad++;
+    if (m == NAIVE) {
+      printf("philo naive: no deadlock this time, which should not happen: FAILED\n");
+      bad++;
+    } else {
+      printf("philo %s: everybody ate %d times, neighbours clashed %d times: %s\n",
+             names[m], hi, T->violations, bad ? "FAILED" : "ok");
+    }
+  }
+
+  for (i = 0; i < N; i++) {
+    sem_destroy(chop[i]);
+    sem_destroy(self_s[i]);
+    cond_destroy(self_c[i]);
+  }
+  sem_destroy(room_s);
+  sem_destroy(mutex_s);
+  sem_destroy(out_s);
+  return bad != 0;
+}
+
+int
+main(int argc, char *argv[])
+{
+  int first = ORDER, last = MONITOR, failed = 0;
+
+  for (int a = 1; a < argc; a++) {
+    if (strcmp(argv[a], "-v") == 0) {
+      verbose = 1;
+      continue;
+    }
+    first = -1;
+    for (int m = 0; m <= MONITOR; m++)
+      if (strcmp(argv[a], names[m]) == 0)
+        first = last = m;
+    if (first < 0) {
+      fprintf(2, "usage: philo [naive|order|room|tanenbaum|monitor] [-v]\n");
+      exit(2);
+    }
+  }
+
+  T = (struct table *)shm_map(1);
+  if ((long)T == -1) {
+    printf("philo: shm_map failed\n");
+    exit(1);
+  }
+  for (int m = first; m <= last; m++)
+    failed += run(m);
+
+  printf("philo: %s\n", failed ? "FAILED" : "PASS");
+  exit(failed != 0);
+}
diff --git a/user/ptest.h b/user/ptest.h
new file mode 100644
index 0000000..d5da1d0
--- /dev/null
+++ b/user/ptest.h
@@ -0,0 +1,135 @@
+// Small helpers shared by the project 5 test and demo programs.
+// Everything is static inline so each program just includes this.
+//
+// The shape of every test is: parent builds shared state with shm_map(),
+// spawn()s a few workers, maybe sleeps a while to let them block, pokes
+// them, then reap()s them. reap() returns how many workers failed. A
+// watchdog process turns a deadlock into a FAIL instead of a hung qemu.
+
+#include "kernel/types.h"
+#include "user/user.h"
+
+#define MAXKID 32
+
+static int kids[MAXKID];
+static int nkids;
+static int dogpid;
+
+// Fail the whole program (nonzero exit) with a message.
+#define CHECK(cond, msg) do {                                          \
+    if (!(cond)) {                                                     \
+      printf("FAIL: %s  (%s:%d)\n", msg, __FILE__, __LINE__);          \
+      exit(1);                                                         \
+    }                                                                  \
+  } while (0)
+
+// ticks of the timer, roughly 100 ms each under qemu
+static inline void nap(int ticks) { pause(ticks); }
+
+// short busy delay, to make races more likely without a system call
+static inline void spin(int n)
+{
+  for (volatile int i = 0; i < n; i++)
+    ;
+}
+
+// tiny LCG so every process can have its own pseudo random stream
+static inline uint rnd(uint *seed)
+{
+  *seed = *seed * 1103515245 + 12345;
+  return (*seed >> 16) & 0x7fff;
+}
+
+// Start fn(arg) in a child process. The child exits 0 when fn returns.
+static inline int spawn(void (*fn)(int), int arg)
+{
+  int pid;
+
+  if (nkids >= MAXKID) {
+    printf("FAIL: too many workers\n");
+    exit(1);
+  }
+  pid = fork();
+  if (pid < 0) {
+    printf("FAIL: fork\n");
+    exit(1);
+  }
+  if (pid == 0) {
+    fn(arg);
+    exit(0);
+  }
+  kids[nkids++] = pid;
+  return pid;
+}
+
+// After this many ticks without reap() being done, kill everything,
+// including the caller, and say so. Call after the spawn()s: the watchdog
+// is a fork and has to know the pids.
+static inline void watchdog(int ticks)
+{
+  int parent = getpid();
+  int pid = fork();
+
+  if (pid == 0) {
+    nap(ticks);
+    printf("FAIL: watchdog fired after %d ticks (deadlock?)\n", ticks);
+    for (int i = 0; i < nkids; i++)
+      kill(kids[i]);
+    kill(parent);
+    exit(0);
+  }
+  dogpid = pid;
+}
+
+// Wait for every spawn()ed worker. Returns how many exited nonzero.
+static inline int reap(void)
+{
+  int left = nkids, bad = 0, st, pid;
+
+  while (left > 0) {
+    pid = wait(&st);
+    if (pid < 0)
+      break;
+    if (pid == dogpid) { // watchdog went off first
+      dogpid = 0;
+      continue;
+    }
+    if (st != 0)
+      bad++;
+    left--;
+  }
+  if (dogpid > 0) {
+    kill(dogpid);
+    wait(0);
+    dogpid = 0;
+  }
+  nkids = 0;
+  return bad;
+}
+
+// Stop one worker and collect it. Returns its exit status.
+static inline int kill_and_wait(int pid)
+{
+  int st = 0;
+
+  kill(pid);
+  for (;;) {
+    int r = wait(&st);
+    if (r == pid || r < 0)
+      break;
+  }
+  for (int i = 0; i < nkids; i++)
+    if (kids[i] == pid)
+      kids[i] = kids[--nkids];
+  return st;
+}
+
+static inline int *shm_ints(int npages)
+{
+  void *p = shm_map(npages);
+  if (p == (void *)-1) {
+    printf("FAIL: shm_map\n");
+    exit(1);
+  }
+  return (int *)p;
+}
diff --git a/user/rwlock.c b/user/rwlock.c
new file mode 100644
index 0000000..378504f
--- /dev/null
+++ b/user/rwlock.c
@@ -0,0 +1,320 @@
+// Readers-writers with semaphores, both classic variants (Courtois,
+// Heymans, Parnas 1971):
+//
+//   reader preference   readers never wait for a writer that is merely
+//                       waiting; writers can starve
+//   writer preference   as soon as a writer is waiting no new reader may
+//                       start; readers can starve
+//
+//   rwlock                    everything below
+//   rwlock reader|writer      workload + scenario for just that variant
+//
+// Workload: several readers and writers hammer one shared record. Writers
+// update it in two steps with a gap in between, so any reader that gets in
+// while a writer is active sees the halves disagree. Entry checks also
+// count who is inside.
+//
+// Scenario: the difference between the two variants, made visible.
+//   t=0   reader A takes the lock and holds it for a while
+//   t=2   writer W arrives and has to wait for A
+//   t=4   reader B arrives
+// With reader preference B slips in next to A, ahead of W. With writer
+// preference B has to wait behind W.
+
+#include "kernel/types.h"
+#include "user/user.h"
+#include "user/ptest.h"
+
+struct rw {
+  int readcount, writecount;   // guarded by rmutex / wmutex
+  int active_r, active_w;      // who is really inside, for the checks
+  int maxr;                    // most readers inside together
+  int a, b;                    // the record; a == b whenever no writer is mid-update
+  int nlog;
+  int log[8];                  // scenario events, in order
+};
+
+enum { A_IN = 1, A_OUT, W_IN, W_OUT, B_IN, B_OUT };
+
+static struct rw *R;
+static int pref;                 // 0 reader preference, 1 writer preference
+static int rmutex, wmutex, wrt, readtry, resource;   // semaphore handles
+
+// ---- the two protocols ------------------------------------------------
+
+static void
+read_lock(void)
+{
+  if (pref == 0) {
+    sem_wait(rmutex);
+    if (++R->readcount == 1)
+      sem_wait(wrt);
+    sem_post(rmutex);
+  } else {
+    sem_wait(readtry);
+    sem_wait(rmutex);
+    if (++R->readcount == 1)
+      sem_wait(resource);
+    sem_post(rmutex);
+    sem_post(readtry);
+  }
+}
+
+static void
+read_unlock(void)
+{
+  sem_wait(rmutex);
+  if (--R->readcount == 0)
+    sem_post(pref == 0 ? wrt : resource);
+  sem_post(rmutex);
+}
+
+static void
+write_lock(void)
+{
+  if (pref == 0) {
+    sem_wait(wrt);
+  } else {
+    sem_wait(wmutex);
+    if (++R->writecount == 1)
+      sem_wait(readtry);          // first waiting writer shuts the door on readers
+    sem_post(wmutex);
+    sem_wait(resource);
+  }
+}
+
+static void
+write_unlock(void)
+{
+  if (pref == 0) {
+    sem_post(wrt);
+  } else {
+    sem_post(resource);
+    sem_wait(wmutex);
+    if (--R->writecount == 0)
+      sem_post(readtry);          // last writer reopens it
+    sem_post(wmutex);
+  }
+}
+
+// ---- workload ---------------------------------------------------------
+
+#define READERS 4
+#define WRITERS 2
+#define READS   40
+#define WRITES  20
+
+static void
+reader(int id)
+{
+  uint seed = 77 + id;
+
+  for (int i = 0; i < READS; i++) {
+    spin(rnd(&seed) % 400);
+    read_lock();
+    int in = __atomic_add_fetch(&R->active_r, 1, __ATOMIC_SEQ_CST);
+    CHECK(__atomic_load_n(&R->active_w, __ATOMIC_SEQ_CST) == 0, "reader inside with a writer");
+    int m = R->maxr;
+    while (in > m && !__atomic_compare_exchange_n(&R->maxr, &m, in, 0,
+           __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+      ;
+    int x = R->a;
+    spin(rnd(&seed) % 300);
+    if (i % 10 == 0)
+      nap(1);                   // a long read, so that readers pile up
+    CHECK(x == R->b, "reader saw a half-written record");
+    __atomic_sub_fetch(&R->active_r, 1, __ATOMIC_SEQ_CST);
+    read_unlock();
+  }
+}
+
+static void
+writer(int id)
+{
+  uint seed = 99 + id;
+
+  for (int i = 0; i < WRITES; i++) {
+    spin(rnd(&seed) % 800);
+    write_lock();
+    int w = __atomic_fetch_add(&R->active_w, 1, __ATOMIC_SEQ_CST);
+    CHECK(w == 0, "two writers inside");
+    CHECK(__atomic_load_n(&R->active_r, __ATOMIC_SEQ_CST) == 0, "writer inside with readers");
+    int v = R->a;
+    R->a = v + 1;
+    spin(rnd(&seed) % 300);     // readers would see a != b here
+    R->b = v + 1;
+    __atomic_sub_fetch(&R->active_w, 1, __ATOMIC_SEQ_CST);
+    write_unlock();
+  }
+}
+
+static const char *pname[] = { "reader preference", "writer preference" };
+
+static int
+workload(void)
+{
+  int i;
+
+  for (i = 0; i < READERS; i++)
+    spawn(reader, i);
+  for (i = 0; i < WRITERS; i++)
+    spawn(writer, i);
+  watchdog(600);
+  int bad = reap();
+  if (R->a != WRITERS * WRITES || R->b != R->a) {
+    printf("rwlock: lost updates, record is %d/%d, expected %d\n", R->a, R->b, WRITERS * WRITES);
+    bad++;
+  }
+  if (R->maxr < 2) {
+    printf("rwlock: readers never overlapped, that is not a readers-writers lock\n");
+    bad++;
+  }
+  printf("rwlock %s: %d readers + %d writers, record = %d, up to %d readers at once: %s\n",
+         pname[pref], READERS, WRITERS, R->a, R->maxr, bad ? "FAILED" : "ok");
+  return bad != 0;
+}
+
+// ---- scenario ---------------------------------------------------------
+
+static void
+logev(int ev)
+{
+  int i = __atomic_fetch_add(&R->nlog, 1, __ATOMIC_SEQ_CST);
+  R->log[i] = ev;
+}
+
+static int
+position(int ev)
+{
+  for (int i = 0; i < R->nlog; i++)
+    if (R->log[i] == ev)
+      return i;
+  return -1;
+}
+
+static void
+scen_reader_a(int arg)
+{
+  read_lock();
+  logev(A_IN);
+  nap(10);
+  logev(A_OUT);
+  read_unlock();
+}
+
+static void
+scen_writer(int arg)
+{
+  write_lock();
+  logev(W_IN);
+  nap(2);
+  logev(W_OUT);
+  write_unlock();
+}
+
+static void
+scen_reader_b(int arg)
+{
+  read_lock();
+  logev(B_IN);
+  nap(2);
+  logev(B_OUT);
+  read_unlock();
+}
+
+static int
+scenario(void)
+{
+  static const char *evname[] = { "?", "A in", "A out", "W in", "W out", "B in", "B out" };
+  int bad = 0;
+
+  R->nlog = 0;
+  spawn(scen_reader_a, 0);
+  nap(2);
+  spawn(scen_writer, 0);
+  nap(2);
+  spawn(scen_reader_b, 0);
+  watchdog(300);
+  bad = reap();
+
+  printf("rwlock %s, scenario: ", pname[pref]);
+  for (int i = 0; i < R->nlog; i++)
+    printf("%s%s", i ? ", " : "", evname[R->log[i]]);
+  printf("\n");
+
+  int w = position(W_IN), b = position(B_IN);
+  if (R->nlog != 6 || w < 0 || b < 0) {
+    printf("rwlock: scenario did not run to completion\n");
+    return 1;
+  }
+  if (pref == 0 && !(b < w)) {
+    printf("rwlock: reader preference should let B in before W\n");
+    bad++;
+  }
+  if (pref == 1 && !(w < b)) {
+    printf("rwlock: writer preference should make B wait for W\n");
+    bad++;
+  }
+  // and in no case may W overlap with anybody
+  if (position(W_IN) < position(A_OUT) || (position(B_IN) > position(W_IN) && position(B_IN) < position(W_OUT))) {
+    printf("rwlock: writer overlapped with a reader\n");
+    bad++;
+  }
+  return bad != 0;
+}
+
+// ---- main -------------------------------------------------------------
+
+static int
+run(int p)
+{
+  int bad;
+
+  pref = p;
+  memset(R, 0, sizeof(*R));
+  rmutex = sem_init(1);
+  wmutex = sem_init(1);
+  wrt = sem_init(1);
+  readtry = sem_init(1);
+  resource = sem_init(1);
+  if (rmutex < 0 || wmutex < 0 || wrt < 0 || readtry < 0 || resource < 0) {
+    printf("rwlock: out of semaphores\n");
+    return 1;
+  }
+  bad = workload();
+  memset(R, 0, sizeof(*R));
+  bad += scenario();
+
+  sem_destroy(rmutex);
+  sem_destroy(wmutex);
+  sem_destroy(wrt);
+  sem_destroy(readtry);
+  sem_destroy(resource);
+  return bad != 0;
+}
+
+int
+main(int argc, char *argv[])
+{
+  int first = 0, last = 1, failed = 0;
+
+  if (argc > 1) {
+    if (strcmp(argv[1], "reader") == 0)
+      first = last = 0;
+    else if (strcmp(argv[1], "writer") == 0)
+      first = last = 1;
+    else {
+      fprintf(2, "usage: rwlock [reader|writer]\n");
+      exit(2);
+    }
+  }
+  R = (struct rw *)shm_map(1);
+  if ((long)R == -1) {
+    printf("rwlock: shm_map failed\n");
+    exit(1);
+  }
+  for (int p = first; p <= last; p++)
+    failed += run(p);
+  printf("rwlock: %s\n", failed ? "FAILED" : "PASS");
+  exit(failed != 0);
+}
diff --git a/user/semtest.c b/user/semtest.c
new file mode 100644
index 0000000..e1f259d
--- /dev/null
+++ b/user/semtest.c
@@ -0,0 +1,262 @@
+// Unit tests for the semaphore system calls.
+
+#include "kernel/types.h"
+#include "kernel/param.h"
+#include "user/user.h"
+#include "user/ptest.h"
+
+static int *shared; // shared[0..]: scratch cells for the workers
+
+// --- individual tests -------------------------------------------------
+
+static void
+test_basic(void)
+{
+  int s = sem_init(2);
+  CHECK(s >= 0, "sem_init");
+  CHECK(sem_getvalue(s) == 2, "initial value");
+  CHECK(sem_wait(s) == 0 && sem_wait(s) == 0, "two waits succeed");
+  CHECK(sem_getvalue(s) == 0, "value is 0 after two waits");
+  CHECK(sem_trywait(s) == 1, "trywait on empty reports would-block");
+  CHECK(sem_post(s) == 0, "post");
+  CHECK(sem_getvalue(s) == 1, "value is 1 after post");
+  CHECK(sem_trywait(s) == 0, "trywait takes the token");
+  CHECK(sem_destroy(s) == 0, "destroy");
+  CHECK(sem_destroy(s) == -1, "second destroy fails");
+  CHECK(sem_wait(s) == -1, "wait on destroyed handle fails");
+  CHECK(sem_post(s) == -1, "post on destroyed handle fails");
+}
+
+static void
+test_bad_handles(void)
+{
+  CHECK(sem_init(-1) == -1, "negative initial value rejected");
+  CHECK(sem_wait(-1) == -1, "wait(-1)");
+  CHECK(sem_wait(NSEM) == -1, "wait(NSEM)");
+  CHECK(sem_post(100000) == -1, "post(100000)");
+  CHECK(sem_trywait(-5) == -1, "trywait(-5)");
+  CHECK(sem_destroy(NSEM + 3) == -1, "destroy out of range");
+  // a handle that was destroyed is dead for good
+  int s = sem_init(0);
+  CHECK(s >= 0, "sem_init");
+  CHECK(sem_destroy(s) == 0, "destroy");
+  CHECK(sem_getvalue(s) == -1, "stale handle");
+}
+
+static void
+test_overflow(void)
+{
+  int s = sem_init(0x7fffffff);
+  CHECK(s >= 0, "init INT_MAX");
+  CHECK(sem_post(s) == -1, "post at INT_MAX fails");
+  CHECK(sem_wait(s) == 0, "wait");
+  CHECK(sem_post(s) == 0, "post fits again");
+  sem_destroy(s);
+}
+
+static void
+test_table_full(void)
+{
+  int h[NSEM + 1], n = 0, i;
+
+  while (n <= NSEM && (h[n] = sem_init(1)) >= 0)
+    n++;
+  CHECK(n == NSEM, "exactly NSEM semaphores can exist");
+  CHECK(sem_init(1) == -1, "table full");
+  for (i = 0; i < n; i++)
+    CHECK(sem_destroy(h[i]) == 0, "destroy all");
+  CHECK((h[0] = sem_init(1)) >= 0, "slot free again");
+  sem_destroy(h[0]);
+}
+
+static void
+leaky_child(int arg)
+{
+  // grabs every slot and exits without destroying any of them
+  while (sem_init(0) >= 0)
+    ;
+}
+
+static void
+test_exit_releases(void)
+{
+  spawn(leaky_child, 0);
+  CHECK(reap() == 0, "child ran");
+  // if the child's handles had leaked, this would come up short
+  int h[NSEM + 1], n = 0, i;
+  while (n <= NSEM && (h[n] = sem_init(0)) >= 0)
+    n++;
+  CHECK(n == NSEM, "dead process released its semaphores");
+  for (i = 0; i < n; i++)
+    sem_destroy(h[i]);
+}
+
+static void
+blocker(int s)
+{
+  if (sem_wait(s) < 0)
+    exit(1);
+  shared[0] = 1;
+}
+
+static void
+test_blocking(void)
+{
+  int s = sem_init(0);
+  shared[0] = 0;
+  spawn(blocker, s);
+  nap(3);
+  CHECK(shared[0] == 0, "waiter is still blocked");
+  CHECK(sem_getvalue(s) == 0, "no token while a waiter sleeps");
+  CHECK(sem_post(s) == 0, "post");
+  CHECK(reap() == 0, "waiter finished");
+  CHECK(shared[0] == 1, "waiter ran after the post");
+  CHECK(sem_getvalue(s) == 0, "token went straight to the waiter");
+  sem_destroy(s);
+}
+
+static void
+fifo_waiter(int arg)
+{
+  int s = arg >> 8, id = arg & 0xff;
+  if (sem_wait(s) < 0)
+    exit(1);
+  int slot = __atomic_fetch_add(&shared[1], 1, __ATOMIC_SEQ_CST);
+  shared[2 + slot] = id;
+}
+
+static void
+test_fifo(void)
+{
+  int s = sem_init(0), i;
+  shared[1] = 0;
+  for (i = 0; i < 6; i++) {
+    spawn(fifo_waiter, (s << 8) | i);
+    nap(2); // let it block before the next one arrives
+  }
+  for (i = 0; i < 6; i++) {
+    CHECK(sem_post(s) == 0, "post");
+    nap(2); // let the woken one log itself
+  }
+  CHECK(reap() == 0, "waiters finished");
+  for (i = 0; i < 6; i++)
+    CHECK(shared[2 + i] == i, "wakeups come in arrival order");
+  sem_destroy(s);
+}
+
+static void
+test_kill_waiter(void)
+{
+  int s = sem_init(0);
+  int pid = spawn(blocker, s);
+  nap(3);
+  int st = kill_and_wait(pid);
+  CHECK(st == -1, "killed waiter exits with -1");
+  // The dead process must not still be on the queue, or this token
+  // would be handed to a ghost and lost.
+  CHECK(sem_post(s) == 0, "post");
+  CHECK(sem_getvalue(s) == 1, "token was not eaten by the dead waiter");
+  CHECK(sem_trywait(s) == 0, "token is there");
+  sem_destroy(s);
+}
+
+static void
+user_of_inherited(int s)
+{
+  // parent has already destroyed its own handle
+  if (sem_wait(s) != 0)
+    exit(1);
+  if (sem_getvalue(s) != 0)
+    exit(1);
+}
+
+static void
+test_inherit(void)
+{
+  int s = sem_init(1);
+  spawn(user_of_inherited, s);
+  CHECK(sem_destroy(s) == 0, "parent drops its handle");
+  CHECK(sem_post(s) == -1, "parent can no longer use it");
+  CHECK(reap() == 0, "child still has a working semaphore");
+}
+
+static void
+counter_worker(int arg)
+{
+  int s = arg;
+  for (int i = 0; i < 400; i++) {
+    sem_wait(s);
+    int t = shared[0];
+    spin(20);           // wide window for a race, if there were one
+    shared[0] = t + 1;
+    sem_post(s);
+  }
+}
+
+static void
+test_mutual_exclusion(void)
+{
+  int s = sem_init(1), i;
+  shared[0] = 0;
+  for (i = 0; i < 4; i++)
+    spawn(counter_worker, s);
+  watchdog(300);
+  CHECK(reap() == 0, "workers finished");
+  CHECK(shared[0] == 1600, "no lost updates under a binary semaphore");
+  sem_destroy(s);
+}
+
+static void
+test_counting(void)
+{
+  // a semaphore with N tokens lets exactly N processes through at once
+  int s = sem_init(3), i;
+  shared[0] = 0; // inside right now
+  shared[1] = 0; // most that were ever inside together
+  for (i = 0; i < 6; i++) {
+    int pid = fork();
+    if (pid == 0) {
+      for (int k = 0; k < 4; k++) {
+        sem_wait(s);
+        int in = __atomic_add_fetch(&shared[0], 1, __ATOMIC_SEQ_CST);
+        int m = shared[1];
+        while (in > m && !__atomic_compare_exchange_n(&shared[1], &m, in, 0,
+               __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+          ;
+        nap(1);   // hold the token across a timer tick so the others pile up
+        __atomic_sub_fetch(&shared[0], 1, __ATOMIC_SEQ_CST);
+        sem_post(s);
+      }
+      exit(0);
+    }
+    kids[nkids++] = pid;
+  }
+  watchdog(300);
+  CHECK(reap() == 0, "workers finished");
+  CHECK(shared[1] == 3, "exactly 3 were inside together, never more");
+  sem_destroy(s);
+}
+
+// --- driver -----------------------------------------------------------
+
+#define RUN(t) do { printf("  %s ... ", #t); t(); printf("ok\n"); } while (0)
+
+int
+main(void)
+{
+  shared = shm_ints(1);
+  printf("semtest\n");
+  RUN(test_basic);
+  RUN(test_bad_handles);
+  RUN(test_overflow);
+  RUN(test_table_full);
+  RUN(test_exit_releases);
+  RUN(test_blocking);
+  RUN(test_fifo);
+  RUN(test_kill_waiter);
+  RUN(test_inherit);
+  RUN(test_mutual_exclusion);
+  RUN(test_counting);
+  printf("semtest: PASS\n");
+  exit(0);
+}
diff --git a/user/shmtest.c b/user/shmtest.c
new file mode 100644
index 0000000..6bc41e0
--- /dev/null
+++ b/user/shmtest.c
@@ -0,0 +1,186 @@
+// Tests for shm_map(): the shared pages that make fork-based
+// synchronization possible, and the page reference counting under them.
+
+#include "kernel/types.h"
+#include "kernel/param.h"
+#include "user/user.h"
+#include "user/ptest.h"
+
+static void
+test_limits(void)
+{
+  CHECK(shm_map(0) == (void *)-1, "0 pages");
+  CHECK(shm_map(-4) == (void *)-1, "negative pages");
+  CHECK(shm_map(SHM_MAXPAGES + 1) == (void *)-1, "more than the cap");
+}
+
+static void
+test_zeroed_and_stacking(void)
+{
+  char *a = shm_map(2);
+  char *b = shm_map(1);
+  CHECK(a != (char *)-1 && b != (char *)-1, "shm_map");
+  CHECK(b + 4096 == a, "regions stack downwards without gaps");
+  for (int i = 0; i < 2 * 4096; i += 97)
+    CHECK(a[i] == 0, "fresh pages are zeroed");
+  a[0] = 1;
+  a[2 * 4096 - 1] = 2;   // both ends writable
+  b[0] = 3;
+}
+
+static void
+test_shared_with_child(void)
+{
+  int *c = shm_ints(1);
+  c[0] = 10;
+  int pid = fork();
+  if (pid == 0) {
+    c[0] += 5;           // visible to the parent
+    c[1] = 99;
+    exit(0);
+  }
+  wait(0);
+  CHECK(c[0] == 15 && c[1] == 99, "parent sees the child's writes");
+}
+
+static void
+test_heap_stays_private(void)
+{
+  int n = 100 * 1024;
+  char *heap = malloc(n);
+  int *c = shm_ints(1);
+  CHECK(heap != 0, "malloc");
+  memset(heap, 7, n);
+  c[0] = 0;
+  int pid = fork();
+  if (pid == 0) {
+    for (int i = 0; i < n; i += 511)
+      if (heap[i] != 7)
+        exit(1);          // child got a copy of the heap
+    memset(heap, 8, n);   // ... which it may scribble on
+    c[0] = 1;
+    exit(0);
+  }
+  int st;
+  wait(&st);
+  CHECK(st == 0, "child saw the parent's heap contents");
+  CHECK(c[0] == 1, "shared write arrived");
+  for (int i = 0; i < n; i += 511)
+    CHECK(heap[i] == 7, "child's heap writes did not leak into the parent");
+  free(heap);
+}
+
+// the earlier tests already mapped 6 pages in this process, and the
+// per-process cap counts them (children inherit them)
+#define BIG (SHM_MAXPAGES - 8)
+
+static void
+test_no_leak_on_exit(void)
+{
+  // 600 * 56 pages is more than all of RAM. If exiting processes did not
+  // give their shared pages back, kalloc would run dry long before the end.
+  for (int i = 0; i < 600; i++) {
+    int pid = fork();
+    CHECK(pid >= 0, "fork");
+    if (pid == 0) {
+      char *m = shm_map(BIG);
+      if (m == (char *)-1)
+        exit(1);
+      m[0] = 1;
+      m[BIG * 4096 - 1] = 1;
+      exit(0);
+    }
+    int st;
+    wait(&st);
+    CHECK(st == 0, "child could always map its pages");
+  }
+}
+
+static void
+test_no_leak_on_exec(void)
+{
+  // exec throws the shared window away; the pages must go with it
+  char *args[] = { "echo", "x", 0 };
+  for (int i = 0; i < 600; i++) {
+    int pid = fork();
+    CHECK(pid >= 0, "fork");
+    if (pid == 0) {
+      if (shm_map(BIG) == (void *)-1)
+        exit(1);
+      close(1);               // keep echo quiet
+      exec("echo", args);
+      exit(2);
+    }
+    int st;
+    wait(&st);
+    CHECK(st == 0, "map then exec");
+  }
+}
+
+static void
+test_many_sharers(void)
+{
+  // one page, eight processes holding it; it must survive until the last
+  // of them has gone, whatever the order
+  int *c = shm_ints(1);
+  c[0] = 0;
+  for (int i = 0; i < 8; i++) {
+    int pid = fork();
+    CHECK(pid >= 0, "fork");
+    if (pid == 0) {
+      nap(1 + i % 3);
+      __atomic_fetch_add(&c[0], 1, __ATOMIC_SEQ_CST);
+      exit(0);
+    }
+  }
+  for (int i = 0; i < 8; i++)
+    wait(0);
+  CHECK(c[0] == 8, "all eight updates landed");
+}
+
+static void
+test_fork_failure_paths(void)
+{
+  // fill the process table, fork keeps failing cleanly, and nothing leaks
+  int pids[NPROC], n = 0;
+  char *m = shm_map(4);
+  CHECK(m != (char *)-1, "shm_map");
+  for (;;) {
+    int pid = fork();
+    if (pid < 0)
+      break;
+    if (pid == 0) {
+      for (;;)
+        nap(100);
+    }
+    pids[n++] = pid;
+  }
+  CHECK(n > 10, "forked a good number");
+  for (int i = 0; i < n; i++)
+    kill(pids[i]);
+  for (int i = 0; i < n; i++)
+    wait(0);
+  int pid = fork();
+  if (pid == 0)
+    exit(0);
+  CHECK(pid > 0, "fork works again after the table drained");
+  wait(0);
+}
+
+#define RUN(t) do { printf("  %s ... ", #t); t(); printf("ok\n"); } while (0)
+
+int
+main(void)
+{
+  printf("shmtest\n");
+  RUN(test_limits);
+  RUN(test_zeroed_and_stacking);
+  RUN(test_shared_with_child);
+  RUN(test_heap_stays_private);
+  RUN(test_many_sharers);
+  RUN(test_no_leak_on_exit);
+  RUN(test_no_leak_on_exec);
+  RUN(test_fork_failure_paths);
+  printf("shmtest: PASS\n");
+  exit(0);
+}
